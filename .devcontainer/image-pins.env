# Every version this image installs, in one place.
#
# This file is the image's only source of truth: it is copied into the build
# context and sourced by each install step, so there are no version literals in
# the Dockerfile to keep in agreement with it. Change a version here and
# rebuild.
#
# It ships inside the image at /usr/local/share/image-pins.env as well, so the
# environment can always be asked what it is made of.
#
# Shell syntax on purpose: `set -a; . ./image-pins.env; set +a` works in a
# Makefile recipe, in a workflow step and in a container entrypoint alike.

# The base. Unlike everything below, these two are also literals in the
# Dockerfile, because a `FROM` line is resolved before any file can be read.
# tests/test_pins.py in the operations repository asserts the two agree.
DEVCONTAINER_BASE_IMAGE=mcr.microsoft.com/devcontainers/base:bookworm
DEVCONTAINER_BASE_DIGEST=sha256:86165cfc170e9b2aa8df90b847127eea97b08eb9987021e6e6ec6c3a96545d7c

# What the work needs. The JDK is fetched by exact build rather than by feature
# so the same bytes compile the candidate's code and ours.
JDK_BUILD=21.0.5+11
MAVEN_VERSION=3.9.9
KUBECTL_VERSION=1.31.2
HELM_VERSION=3.16.3
KUSTOMIZE_VERSION=5.5.0
TOFU_VERSION=1.8.6
KIND_VERSION=0.24.0

# What the submission is checked with. These ship in the candidate's image on
# purpose: every check a submission faces can be run by the candidate first.
GITLEAKS_VERSION=8.21.2
HADOLINT_VERSION=2.12.0
TFLINT_VERSION=0.53.0
CHECKOV_VERSION=3.3.16
CONFTEST_VERSION=0.56.0
HCL2JSON_VERSION=0.6.4
KUBECONFORM_VERSION=0.6.7

# Docker here is the client only: the daemon is supplied by the
# docker-in-docker feature for candidates, and by a mounted socket for
# grading. Pinned below v27 for the same reason the feature is: the v27 IPv6
# default breaks `kind create cluster` in Codespaces.
DOCKER_VERSION=26.1.4
DOCKER_COMPOSE_VERSION=2.27.1
